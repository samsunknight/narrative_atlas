.venv/
__pycache__/
*.pyc
*.bak*
.DS_Store

# Full scored atlas — released as GitHub Release data assets, not tracked in git
data/atlas/*_atlas.csv
data/atlas/century_frame.parquet

# Generated outputs — regenerated by reproduce.py, not tracked
results/
outputs/

# IMDb data (non-commercial license) — not redistributed; rebuild via code/rebuild_imdb_match.py
data/matched/imdb_film_ratings.csv
data/matched/imdb_film_genres.csv
data/validation/validation_plot_text_film.csv

# Local caches and verify-mode intermediates — not part of the release
data/novelty/
data/validation/newattr_final_recomputed.csv

# regenerated by rebuild_spine_from_atlas.py in run_all.sh (verification output, not an input)
data/corpus_rebuilt/

# working intermediates and regenerated artifacts — not part of the replication package
data/atlas/newscore*/
data/atlas/desc_revalidation/
data/atlas/*.pre_newattr.parquet
data/atlas/*_atlas.csv
data/atlas/century_frame.parquet
data/atlas/drip_*
data/corpus_rebuilt/
data/corpus/*_structural_century.csv
**/* (Selective Sync Conflict)/
pnas-sub/analysis/out/
pnas-sub/analysis/**/__pycache__/

# manuscript prose (unpublished) — not distributed in the replication package;
# place main.tex / si.tex / sections/ here to run verify_paper's manuscript-consistency check
pnas-sub/main.tex
pnas-sub/si.tex
pnas-sub/sections/

# raw Wikipedia plot text — not redistributed (see Data Availability)
data/validation/validation_plot_text_*.csv
data/*_wiki_text*.parquet
